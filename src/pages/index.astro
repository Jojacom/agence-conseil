---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import Method from '../components/sections/Method.astro';
import AboutUs from '../components/sections/AboutUs.astro';
import Contact from '../components/sections/Contact.astro';
import Proof from '../components/sections/Proof.astro';
import WaxBand from '../components/shared/WaxBand.astro';
---

<Layout title="JOJACOM – Agence de communication digitale à Dakar, Sénégal">
	<main id="contenu" class="flex flex-col gap-y-20 md:gap-y-32 overflow-hidden">
		<Hero/>
		<WaxBand/>
		<Services/>
		<Method/>
		<AboutUs/>
		<Proof/>
		<Contact/>
	</main>
</Layout>
