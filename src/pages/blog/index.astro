---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/shared/Container.astro";
import Paragraph from "../../components/shared/Paragraph.astro";
import PostCard from "../../components/cards/PostCard.astro";
import Contact from "../../components/sections/Contact.astro";
import { getPublishedPosts } from "../../utils/blog";
import { site } from "../../utils/site";

const posts = await getPublishedPosts();
const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "Blog",
        name: "Le blog de JOJACOM",
        url: `${site.url}/blog/`,
        publisher: { "@id": `${site.url}/#entreprise` },
        blogPost: posts.map((p) => ({ "@type": "BlogPosting", headline: p.data.title, url: `${site.url}/blog/${p.id}/` })),
    },
];
---

<Layout title="Blog : conseils digitaux pour le Sénégal | JOJACOM" description="Conseils pratiques pour les entreprises sénégalaises : site web, réseaux sociaux, publicité en ligne et référencement, par JOJACOM, agence digitale à Dakar." jsonLd={jsonLd}>
    <main id="contenu" class="flex flex-col gap-y-20 md:gap-y-28 overflow-hidden">
        <section class="pt-10 lg:pt-16" aria-labelledby="blog-titre" data-hide-float>
            <Container>
                <h1 id="blog-titre" class="text-3xl/tight sm:text-4xl/tight md:text-5xl/tight font-bold text-heading-1">Le blog</h1>
                <Paragraph className="mt-6 max-w-2xl">
                    Des conseils concrets pour développer votre entreprise en ligne au Sénégal : site web, réseaux sociaux, publicité et référencement.
                </Paragraph>
                <ul class="mt-12 grid md:grid-cols-2 gap-x-12 gap-y-10">
                    {posts.map((post) => <PostCard post={post} />)}
                </ul>
            </Container>
        </section>
        <Contact />
    </main>
</Layout>
