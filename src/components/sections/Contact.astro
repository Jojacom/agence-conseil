---
import Container from "../shared/Container.astro";
import Decor from "../shared/Decor.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { services } from "../../utils/data";
import { site, whatsappLink } from "../../utils/site";

const field =
    "mt-2 w-full rounded-2xl border border-box-border bg-body px-4 py-3 text-heading-2 placeholder:text-heading-3/80 focus:border-primaryv aria-invalid:border-red-700 aria-invalid:border-2 dark:aria-invalid:border-red-400";
const label = "block text-sm font-semibold text-heading-2";
---

<section id="contact" aria-labelledby="contact-titre" class="pb-20">
    <Container>
        <div class="w-full relative py-10 md:py-14 px-5 sm:px-8 md:px-12 rounded-3xl bg-linear-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-gray-950 overflow-hidden">
            <Decor />
            <div class="relative grid lg:grid-cols-5 gap-10 lg:gap-14">
                <div class="lg:col-span-2">
                    <Title id="contact-titre" className="sm:text-4xl/tight md:text-5xl/tight font-bold">
                        Parlons de votre projet
                    </Title>
                    <Paragraph className="mt-6">
                        Décrivez-nous votre besoin en quelques lignes : nous vous répondons immédiatement pour en discuter et vous proposer un plan d'action adapté.
                    </Paragraph>
                    <p class="mt-6 inline-flex items-center gap-2 rounded-full bg-[#0F7A41]/10 border border-[#0F7A41]/30 px-4 py-2 text-sm font-semibold text-heading-1">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4 text-[#0F7A41] dark:text-green-400" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
                        Réponse immédiate
                    </p>

                    <ul class="mt-8 space-y-4 text-heading-2">
                        <li>
                            <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 font-semibold hover:text-primaryv dark:hover:text-primary">
                                <span aria-hidden="true" class="w-10 h-10 rounded-full bg-[#0F7A41] text-white inline-flex items-center justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.05 21.5a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.56.93.95-3.47-.22-.36A9.4 9.4 0 0 1 2.6 12.06c0-5.2 4.24-9.44 9.46-9.44 2.52 0 4.9.99 6.68 2.77a9.37 9.37 0 0 1 2.76 6.68c0 5.21-4.24 9.44-9.45 9.44zm8.04-17.48A11.3 11.3 0 0 0 12.05.7C5.78.7.68 5.8.68 12.06c0 2 .52 3.96 1.52 5.68L.58 23.62l6.02-1.58a11.34 11.34 0 0 0 5.44 1.39c6.26 0 11.36-5.1 11.37-11.37 0-3.04-1.18-5.89-3.33-8.04z"/></svg>
                                </span>
                                <span>WhatsApp (messages) : <span class="whitespace-nowrap">{site.whatsappDisplay}</span></span>
                                <span class="sr-only">(nouvel onglet)</span>
                            </a>
                        </li>
                        <li>
                            <a href={`tel:${site.phoneHref}`} class="inline-flex items-center gap-3 font-semibold hover:text-primaryv dark:hover:text-primary">
                                <span aria-hidden="true" class="w-10 h-10 rounded-full bg-primaryv text-white inline-flex items-center justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
                                </span>
                                <span>Appels : <span class="whitespace-nowrap">{site.phoneDisplay}</span></span>
                            </a>
                        </li>
                        <li>
                            <a href={`mailto:${site.email}`} class="inline-flex items-center gap-3 font-semibold hover:text-primaryv dark:hover:text-primary">
                                <span aria-hidden="true" class="w-10 h-10 rounded-full bg-heading-1 text-body inline-flex items-center justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
                                </span>
                                {site.email}
                            </a>
                        </li>
                    </ul>
                </div>

                <form data-contact-form class="lg:col-span-3 grid sm:grid-cols-2 gap-5 rounded-3xl bg-box-bg border border-box-border p-5 sm:p-8 shadow-lg shadow-box-shadow" novalidate>
                    <p class="sm:col-span-2 text-sm text-heading-3">Les champs marqués d'un <span aria-hidden="true">*</span><span class="sr-only">astérisque</span> sont obligatoires.</p>
                    <div>
                        <label for="c-nom" class={label}>Nom et prénom <span aria-hidden="true">*</span></label>
                        <input id="c-nom" name="nom" type="text" autocomplete="name" required class={field} />
                    </div>
                    <div>
                        <label for="c-entreprise" class={label}>Entreprise</label>
                        <input id="c-entreprise" name="entreprise" type="text" autocomplete="organization" class={field} />
                    </div>
                    <div>
                        <label for="c-tel" class={label}>Téléphone <span aria-hidden="true">*</span></label>
                        <input id="c-tel" name="telephone" type="tel" autocomplete="tel" inputmode="tel" required placeholder="77 000 00 00" aria-describedby="c-tel-aide" class={field} />
                        <p id="c-tel-aide" class="mt-1.5 text-xs text-heading-3">Ex. : 77 123 45 67, ou +33 6 12 34 56 78 depuis l'étranger</p>
                    </div>
                    <div>
                        <label for="c-service" class={label}>Service souhaité</label>
                        <select id="c-service" name="service" class={field}>
                            <option value="">Je ne sais pas encore</option>
                            {services.map((s) => <option>{s.title}</option>)}
                        </select>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="c-message" class={label}>Votre projet <span aria-hidden="true">*</span></label>
                        <textarea id="c-message" name="message" rows="4" required placeholder="Votre activité, vos objectifs, vos délais…" class={field}></textarea>
                    </div>
                    <p data-form-error id="c-erreur" role="alert" class="sm:col-span-2 text-sm font-semibold text-red-700 dark:text-red-400 empty:hidden"></p>
                    <div class="sm:col-span-2 flex flex-col sm:flex-row gap-3">
                        <button type="submit" value="whatsapp" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full font-semibold bg-[#0F7A41] text-white hover:bg-[#0b5e32] transition">
                            Envoyer par WhatsApp
                        </button>
                        <button type="submit" value="email" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full font-semibold border border-box-border text-heading-1 hover:border-primaryv transition">
                            Envoyer par e-mail
                        </button>
                    </div>
                    <p class="sm:col-span-2 text-xs text-heading-3">
                        Votre message s'ouvre dans WhatsApp ou dans votre messagerie : il vous suffit de l'envoyer. Aucune donnée n'est enregistrée sur ce site.
                    </p>
                    <div data-form-success role="status" tabindex="-1" hidden class="sm:col-span-2 rounded-2xl border-2 border-[#0F7A41] bg-[#0F7A41]/10 p-4 sm:p-5 text-heading-2">
                        <p class="font-semibold text-heading-1" data-success-title></p>
                        <p class="mt-1 text-sm">Il ne vous reste plus qu'à appuyer sur « Envoyer » dans <span data-success-app></span> : nous vous répondons immédiatement. Vos informations restent dans le formulaire si vous voulez les modifier.</p>
                        <p class="mt-3 text-sm">
                            Rien ne s'est ouvert&nbsp;? Écrivez-nous directement sur{" "}
                            <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="font-semibold underline underline-offset-4">WhatsApp au <span class="whitespace-nowrap">{site.whatsappDisplay}</span><span class="sr-only"> (nouvel onglet)</span></a>{" "}
                            ou à{" "}<a href={`mailto:${site.email}`} class="font-semibold underline underline-offset-4">{site.email}</a>.
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </Container>
</section>

<script define:vars={{ whatsapp: site.whatsapp, email: site.email }}>
    const form = document.querySelector("[data-contact-form]");
    const error = form?.querySelector("[data-form-error]");
    const success = form?.querySelector("[data-form-success]");
    const tel = form?.querySelector("#c-tel");

    // Numéro sénégalais (9 chiffres commençant par 7 ou 3, avec ou sans +221)
    // ou numéro international (+ ou 00 suivi de 8 à 15 chiffres).
    const phoneOk = (value) => {
        const v = value.replace(/[\s.\-()]/g, "");
        return /^(\+221|00221)?[37]\d{8}$/.test(v) || /^(\+|00)\d{8,15}$/.test(v);
    };
    const labelOf = (el) => form.querySelector(`label[for="${el.id}"]`).firstChild.textContent.trim();

    // L'erreur disparaît dès que le champ est corrigé
    form?.addEventListener("input", (e) => {
        const el = e.target;
        if (el.getAttribute("aria-invalid") !== "true") return;
        const fixed = el === tel ? phoneOk(el.value) : el.value.trim() !== "";
        if (fixed) el.removeAttribute("aria-invalid");
    });

    form?.addEventListener("submit", (e) => {
        e.preventDefault();
        success.hidden = true;
        const required = [...form.querySelectorAll("[required]")];
        const missing = required.filter((el) => !el.value.trim());
        const badPhone = tel.value.trim() !== "" && !phoneOk(tel.value);
        const invalid = badPhone ? [...missing, tel] : missing;
        required.forEach((el) => {
            if (invalid.includes(el)) {
                el.setAttribute("aria-invalid", "true");
                el.setAttribute("aria-errormessage", "c-erreur");
            } else {
                el.removeAttribute("aria-invalid");
            }
        });
        if (invalid.length) {
            const parts = [];
            if (missing.length) parts.push("Merci de remplir : " + missing.map(labelOf).join(", ") + ".");
            if (badPhone) parts.push("Le numéro de téléphone ne semble pas valide (ex. : 77 123 45 67).");
            error.textContent = parts.join(" ");
            invalid[0].focus();
            return;
        }
        error.textContent = "";

        const data = new FormData(form);
        const lines = [
            "Bonjour JOJACOM,",
            "",
            `Nom : ${data.get("nom")}`,
            data.get("entreprise") ? `Entreprise : ${data.get("entreprise")}` : null,
            `Téléphone : ${data.get("telephone")}`,
            data.get("service") ? `Service souhaité : ${data.get("service")}` : null,
            "",
            String(data.get("message")),
        ].filter((l) => l !== null);
        const text = lines.join("\n");

        const via = e.submitter?.value === "email" ? "email" : "whatsapp";
        if (via === "email") {
            const subject = `Demande de contact – ${data.get("nom")}`;
            window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
        } else {
            window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(text)}`, "_blank", "noopener");
        }

        // Confirmation : le message est prêt, il reste à l'envoyer
        success.querySelector("[data-success-title]").textContent =
            via === "email" ? "Votre e-mail est prêt dans votre messagerie." : "Votre message est prêt dans WhatsApp.";
        success.querySelector("[data-success-app]").textContent = via === "email" ? "votre messagerie" : "WhatsApp";
        success.hidden = false;
        success.focus({ preventScroll: true });
        success.scrollIntoView({ block: "nearest", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    });
</script>
