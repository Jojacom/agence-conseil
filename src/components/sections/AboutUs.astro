---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
---

<section id="about-us" aria-labelledby="about-titre">
    <Container className="flex flex-col midmd:flex-row gap-10 lg:gap-12">
        <div class="max-w-md mx-auto midmd:max-w-none lg:mx-0 lg:pr-10 xl:pr-2 flex-1 flex w-11/12 midmd:w-5/12 lg:w-1/2 midmd:h-auto">
            <div class="w-full h-80 sm:h-96 midmd:h-full relative">
                <img src="/images/dev-with-c-1.webp" alt=""
                    width="863" height="988" loading="lazy" decoding="async"
                    class="w-auto left-1/2 -translate-x-1/2 absolute bottom-0 max-h-full" />
            </div>
        </div>
        <div class="flex-1 flex midmd:w-7/12 lg:w-1/2 flex-col">
            <Title id="about-titre">
                Une agence sénégalaise, au service de votre croissance
            </Title>
            <Paragraph className="mt-8">
                JOJACOM est une agence de communication digitale installée à Dakar. Nous connaissons le marché local, ses
                habitudes et ses canaux, et nous mettons cette connaissance au service des entreprises qui veulent grandir en ligne.
            </Paragraph>
            <dl class="mt-10 grid sm:grid-cols-2 gap-8">
                <div class="border-t-2 border-primaryv dark:border-primary pt-5">
                    <dt class="text-lg md:text-xl font-semibold text-heading-1">Notre mission</dt>
                    <dd class="mt-3 md:text-lg text-heading-3">Être le partenaire de votre ascension digitale au Sénégal, avec des stratégies publicitaires innovantes et des solutions adaptées à votre budget.</dd>
                </div>
                <div class="border-t-2 border-primaryv dark:border-primary pt-5">
                    <dt class="text-lg md:text-xl font-semibold text-heading-1">Notre vision</dt>
                    <dd class="mt-3 md:text-lg text-heading-3">Anticiper les évolutions du marketing digital pour que votre présence en ligne reste un véritable moteur de développement.</dd>
                </div>
            </dl>
        </div>
    </Container>
</section>
