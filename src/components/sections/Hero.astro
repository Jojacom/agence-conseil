---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import { site, whatsappLink } from "../../utils/site";
---

<section id="accueil" class="relative pt-16 lg:pt-24">
    <Container className="flex flex-col lg:flex-row gap-10 lg:gap-12">
        <div aria-hidden="true" class="pointer-events-none absolute w-full lg:w-1/2 inset-y-0 lg:right-0">
            <span class="absolute -left-6 md:left-4 top-24 lg:top-28 w-24 h-24 rotate-90 skew-x-12 rounded-3xl bg-secondary blur-xl opacity-60 lg:opacity-95 lg:block hidden"></span>
            <span class="absolute right-4 bottom-12 w-24 h-24 rounded-3xl bg-primary blur-xl opacity-80"></span>
        </div>
        <span aria-hidden="true" class="pointer-events-none w-4/12 lg:w-2/12 aspect-square bg-linear-to-tr from-primary to-secondary absolute -top-5 lg:left-0 rounded-full skew-y-12 blur-2xl opacity-40 skew-x-12 rotate-90"></span>

        <div class="relative flex flex-col items-center text-center lg:text-left lg:py-7 xl:py-8 lg:items-start lg:max-w-none max-w-3xl mx-auto lg:mx-0 lg:flex-1 lg:w-1/2">
            <p class="inline-flex items-center gap-2 rounded-full border border-box-border bg-box-bg px-4 py-1.5 text-sm font-semibold text-heading-2">
                <span aria-hidden="true" class="w-2 h-2 rounded-full bg-primaryv"></span>
                Agence de communication digitale à Dakar
            </p>
            <h1 class="mt-6 text-3xl/tight sm:text-4xl/tight md:text-5xl/tight xl:text-6xl/tight font-bold text-heading-1">
                Transformez vos abonnés en{" "}
                <span class="text-transparent bg-clip-text bg-linear-to-br from-primaryv via-primaryv to-primary">clients</span>.
            </h1>
            <Paragraph className="mt-8">
                Stratégie, création de contenu, gestion des réseaux sociaux et publicité sur Facebook, Instagram et Google&nbsp;:
                JOJACOM accompagne les entreprises sénégalaises pour gagner en visibilité et en ventes.
            </Paragraph>
            <div class="mt-10 w-full flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                <BtnLink href="#contact" text="Parlons de votre projet" variant="primary" />
                <BtnLink href={whatsappLink()} target="_blank" variant="secondary" text="Écrire sur WhatsApp">
                    <span class="sr-only"> (nouvel onglet)</span>
                </BtnLink>
            </div>
            <p class="mt-6 text-sm text-heading-3">
                Basés à {site.address.split(",")[0]}, {site.city} · <a href={`tel:${site.phoneHref}`} class="font-semibold underline-offset-4 hover:underline">{site.phoneDisplay}</a>
            </p>
        </div>

        <div class="flex flex-1 lg:w-1/2 lg:h-auto relative lg:max-w-none lg:mx-0 mx-auto max-w-3xl">
            <img
                src="/images/image1.webp"
                alt="Mains tapant sur un ordinateur portable, enveloppées d'un tissu wax, au-dessus d'un globe montrant l'Afrique"
                width="771" height="774"
                fetchpriority="high"
                class="lg:absolute lg:w-full lg:h-full rounded-3xl object-cover lg:max-h-none max-h-96 w-full" />
        </div>
    </Container>
</section>
