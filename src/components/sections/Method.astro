---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { steps } from "../../utils/data";
---

<section id="methode" aria-labelledby="methode-titre">
    <Container className="flex flex-col midmd:flex-row gap-10 lg:gap-12">
        <div class="flex-1 flex midmd:w-7/12 lg:w-1/2 flex-col">
            <Title id="methode-titre">
                Notre méthode, en 4 étapes
            </Title>
            <Paragraph className="mt-6">
                Pas de recette toute faite : chaque accompagnement part de votre entreprise et de vos objectifs.
            </Paragraph>
            <ol class="mt-8 space-y-6">
                {steps.map((step, i) => (
                    <li class="flex gap-4">
                        <span aria-hidden="true" class="flex-none w-10 h-10 rounded-full bg-primaryv text-white font-bold inline-flex justify-center items-center">
                            {i + 1}
                        </span>
                        <div>
                            <h3 class="text-lg md:text-xl font-semibold text-heading-2">
                                <span class="sr-only">Étape {i + 1} : </span>{step.title}
                            </h3>
                            <p class="mt-1 md:text-lg text-heading-3">{step.description}</p>
                        </div>
                    </li>
                ))}
            </ol>
        </div>

        <div class="max-w-md mx-auto midmd:max-w-none lg:mx-0 lg:pr-10 xl:pr-2 flex-1 flex w-11/12 midmd:w-5/12 lg:w-1/2 midmd:h-auto">
            <div class="w-full h-80 sm:h-96 midmd:h-full relative">
                <img src="/images/dev-with-c.webp" alt=""
                    width="935" height="978" loading="lazy" decoding="async"
                    class="w-auto left-1/2 -translate-x-1/2 absolute bottom-0 max-h-full" />
            </div>
        </div>
    </Container>
</section>
