---
import { whatsappLink } from "../../utils/site";
---
<a
    data-whatsapp-float
    href={whatsappLink()}
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-5 right-5 z-40 flex items-center gap-2 rounded-full bg-[#0F7A41] text-white shadow-lg shadow-black/20 p-3.5 sm:px-5 transition duration-300 hover:bg-[#0b5e32] hover:scale-105 data-[hidden=true]:opacity-0 data-[hidden=true]:translate-y-4 data-[hidden=true]:pointer-events-none">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6" aria-hidden="true">
        <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.56.93.95-3.47-.22-.36A9.4 9.4 0 0 1 2.6 12.06c0-5.2 4.24-9.44 9.46-9.44 2.52 0 4.9.99 6.68 2.77a9.37 9.37 0 0 1 2.76 6.68c0 5.21-4.24 9.44-9.45 9.44zm8.04-17.48A11.3 11.3 0 0 0 12.05.7C5.78.7.68 5.8.68 12.06c0 2 .52 3.96 1.52 5.68L.58 23.62l6.02-1.58a11.34 11.34 0 0 0 5.44 1.39h.01c6.26 0 11.36-5.1 11.37-11.37 0-3.04-1.18-5.89-3.33-8.04z"/>
    </svg>
    <span class="sr-only sm:not-sr-only font-semibold">WhatsApp</span>
    <span class="sr-only">(ouvre WhatsApp dans un nouvel onglet)</span>
</a>

<script>
    // Masque le bouton flottant quand le haut de page ou la section Contact est
    // à l'écran : tous deux ont déjà leurs propres liens WhatsApp, et le bouton
    // y recouvrirait du contenu (numéro d'appel, formulaire).
    const floatBtn = document.querySelector<HTMLAnchorElement>("[data-whatsapp-float]");
    const zones = ["accueil", "contact"]
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);
    if (floatBtn && zones.length && "IntersectionObserver" in window) {
        const visible = new Set<Element>();
        const observer = new IntersectionObserver((entries) => {
            for (const entry of entries) {
                if (entry.isIntersecting) visible.add(entry.target);
                else visible.delete(entry.target);
            }
            const hide = visible.size > 0;
            floatBtn.dataset.hidden = String(hide);
            floatBtn.toggleAttribute("inert", hide);
            floatBtn.setAttribute("aria-hidden", String(hide));
        }, { threshold: 0.15 });
        zones.forEach((z) => observer.observe(z));
    }
</script>
