---
import GroupFooterNav from "../blocks/GroupFooterNav.astro";
import Container from "../shared/Container.astro";
import WaxBand from "../shared/WaxBand.astro";
import FooterNav from "../shared/FooterNav.astro";
import svgLogo from '../../images/logo.svg';
import { services } from "../../utils/data";
import { site, whatsappLink } from "../../utils/site";

const footerNavigation = [
    { itemText: "Accueil", itemLink: "#accueil" },
    { itemText: "Services", itemLink: "#services" },
    { itemText: "Méthode", itemLink: "#methode" },
    { itemText: "À propos", itemLink: "#about-us" },
    { itemText: "Contact", itemLink: "#contact" },
];

const footerServices = services.map((s) => ({ itemText: s.title, itemLink: "#services" }));

const socials = [
    {
        name: "Facebook",
        href: site.social.facebook,
        viewBox: "0 0 16 16",
        d: "M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z",
    },
    {
        name: "Instagram",
        href: site.social.instagram,
        viewBox: "0 0 448 512",
        d: "M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z",
    },
    {
        name: "LinkedIn",
        href: site.social.linkedin,
        viewBox: "0 0 16 16",
        d: "M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z",
    },
];

const year = new Date().getFullYear();
---
<footer class="relative bg-linear-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-gray-950 pt-14 rounded-t-3xl overflow-hidden">
    <WaxBand className="absolute inset-x-0 top-0" />
    <Container className="pb-8 relative">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 lg:items-stretch gap-8 relative">
            <div class="sm:col-span-2 lg:col-span-1 h-auto flex flex-col">
                <a href="#accueil" class="relative flex items-center gap-3 w-max rounded-xl">
                    <img src={svgLogo.src} alt="" width="90" height="90" class="w-14 h-14" loading="lazy" />
                    <span class="text-lg font-bold text-heading-1">{site.legalName}</span>
                </a>
                <address class="mt-4 not-italic md:text-lg text-heading-3 space-y-1">
                    <p><strong>Siège social</strong> : {site.address}, {site.city}</p>
                    <p><strong>Appels</strong> : <a href={`tel:${site.phoneHref}`} class="whitespace-nowrap hover:text-primaryv dark:hover:text-primary">{site.phoneDisplay}</a></p>
                    <p><strong>WhatsApp</strong> (messages uniquement) : <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="whitespace-nowrap hover:text-primaryv dark:hover:text-primary">{site.whatsappDisplay}<span class="sr-only"> (nouvel onglet)</span></a></p>
                    <p><strong>E-mail</strong> : <a href={`mailto:${site.email}`} class="hover:text-primaryv dark:hover:text-primary">{site.email}</a></p>
                    <p class="text-sm pt-2">R.C.C.M. : {site.rccm} · N.I.N.E.A : {site.ninea}</p>
                </address>

                <ul class="flex items-center gap-2 text-heading-3 mt-4" aria-label="Réseaux sociaux">
                    {socials.map((s) => (
                        <li>
                            <a href={s.href} target="_blank" rel="noopener noreferrer" class="flex p-2 rounded-full transition hover:text-heading-1 hover:scale-105">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox={s.viewBox} fill="currentColor" class="w-5 h-5" aria-hidden="true"><path d={s.d} /></svg>
                                <span class="sr-only">{s.name} de JOJACOM (nouvel onglet)</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <GroupFooterNav>
                <FooterNav title="Navigation" navItems={footerNavigation}/>
            </GroupFooterNav>

            <GroupFooterNav>
                <FooterNav title="Nos services" navItems={footerServices}/>
            </GroupFooterNav>
        </div>
    </Container>
    <div class="bg-linear-to-tl from-box-bg py-4 relative">
        <Container>
            <p class="text-center sm:text-left text-heading-3">
                &copy; {year} <strong>{site.legalName}</strong>. Tous droits réservés.
            </p>
        </Container>
    </div>
</footer>
