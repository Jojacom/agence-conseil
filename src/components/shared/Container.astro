---
export interface Props{
    className?:string
}

const { className = "" } = Astro.props
// Une largeur maximale passée dans className (ex. « max-w-3xl ») remplace celle par défaut.
const maxWidth = /(^|\s)max-w-/.test(className) ? "" : "max-w-7xl"
---
<div class={`mx-auto ${maxWidth} w-full px-5 sm:px-8 md:px-14 lg:px-5 ${className}`}>
    <slot/>
</div>
