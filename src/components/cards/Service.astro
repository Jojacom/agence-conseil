---
export interface Props{
    title: string,
    description: string,
    icon: string,
    href: string,
}

const { title, description, icon, href } = Astro.props
---
<li class="relative border-t border-box-border pt-6 group">
    <h3 class="flex items-center gap-3 text-lg md:text-xl font-semibold text-heading-1">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 flex-none text-primaryv dark:text-primary" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
        </svg>
        <a href={href} class="after:absolute after:inset-0 group-hover:text-primaryv dark:group-hover:text-primary">{title}</a>
    </h3>
    <p class="mt-3 md:text-lg text-heading-3 max-w-prose">
        {description}
    </p>
    <p class="mt-3 text-sm font-semibold text-primaryv dark:text-primary" aria-hidden="true">En savoir plus →</p>
</li>
