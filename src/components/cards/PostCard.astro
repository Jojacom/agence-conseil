---
import { formatDate, readingTime, type Post } from "../../utils/blog";

export interface Props {
    post: Post;
    headingLevel?: "h2" | "h3";
}
const { post, headingLevel: H = "h2" } = Astro.props;
---
<li class="relative border-t border-box-border pt-6 group">
    <p class="text-sm font-semibold text-primaryv dark:text-primary">{post.data.category}</p>
    <H class="mt-2 text-xl md:text-2xl font-semibold text-heading-1">
        <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0 group-hover:text-primaryv dark:group-hover:text-primary">{post.data.title}</a>
    </H>
    <p class="mt-3 md:text-lg text-heading-3 max-w-prose">{post.data.description}</p>
    <p class="mt-3 text-sm text-heading-3">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingTime(post.body)} min de lecture
    </p>
</li>
